generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GuideStatus {
  DRAFT
  REVIEW
  PUBLISHED
}

enum TimelineStage {
  PRE_ARRIVAL
  FIRST_WEEK
  FIRST_MONTH
  FIRST_SIX_MONTHS
  LONG_TERM
}

enum UserRole {
  ADMIN
  EDITOR
  USER
}

model Module {
  id           String              @id @default(cuid())
  slug         String              @unique
  position     Int                 @default(0)
  icon         String?
  translations ModuleTranslation[]
  guides       Guide[]
}

model ModuleTranslation {
  id       String @id @default(cuid())
  moduleId String
  locale   String
  title    String
  summary  String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, locale])
}

model Guide {
  id             String             @id @default(cuid())
  slug           String             @unique
  moduleId       String
  position       Int                @default(0)
  status         GuideStatus        @default(DRAFT)
  stage          TimelineStage?
  // Date when the content was last checked against official sources
  lastVerifiedAt DateTime?
  sourceUrls     String[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  module         Module             @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  translations   GuideTranslation[]
}

model GuideTranslation {
  id           String @id @default(cuid())
  guideId      String
  locale       String
  title        String
  summary      String
  // Markdown body; may contain {{setting:key}} placeholders for volatile facts
  bodyMarkdown String
  // True while the text still needs a check by a native speaker (e.g. machine-assisted translations)
  needsReview  Boolean @default(false)
  guide        Guide  @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@unique([guideId, locale])
}

model GlossaryTerm {
  id           String                    @id @default(cuid())
  german       String                    @unique
  translations GlossaryTermTranslation[]
}

model GlossaryTermTranslation {
  id         String       @id @default(cuid())
  termId     String
  locale     String
  meaning    String
  term       GlossaryTerm @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@unique([termId, locale])
}

// Volatile facts (salary thresholds, prices) kept in one place
model Setting {
  key       String   @id
  value     String
  note      String?
  updatedAt DateTime @updatedAt
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  // Sessions issued before this moment are rejected (set when the password is created or changed)
  passwordUpdatedAt DateTime @default(now())
}

// Failed and successful admin login attempts, used to slow down password guessing
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

enum PostKind {
  // A personal story written by us or a guest ("Deneyim")
  EXPERIENCE
  // A longer explanatory article
  ARTICLE
}

// Blog post, written in one language (the language of the post)
model Post {
  id           String      @id @default(cuid())
  slug         String      @unique
  locale       String
  kind         PostKind    @default(EXPERIENCE)
  status       GuideStatus @default(DRAFT)
  title        String
  summary      String
  // Markdown body
  bodyMarkdown String
  authorName   String
  tags         String[]
  // Slug of a related guide, shown as a link under the post
  guideSlug    String?
  publishedAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status, publishedAt])
}

enum ChannelKind {
  // Our own channels
  OWN
  // Accounts, podcasts and sites by others that we recommend
  RECOMMENDED
}

// Social media accounts, podcasts and sites we link to (links only, nothing is embedded)
model Channel {
  id          String      @id @default(cuid())
  kind        ChannelKind @default(RECOMMENDED)
  platform    String
  name        String
  url         String
  description String
  // Topic key, e.g. language, food, life (labels live in the messages)
  topic       String
  // Language of the channel's content: tr, de, en or other
  language    String
  // Paid or affiliated link: shown with an "Ad" label and rel="sponsored"
  sponsored   Boolean     @default(false)
  published   Boolean     @default(false)
  position    Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}
