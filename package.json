{
  "name": "germany-guide",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:up": "docker compose up -d",
    "postinstall": "prisma generate",
    "admin:create": "tsx --env-file=.env prisma/create-admin.ts",
    "check:legal": "tsx scripts/check-legal.ts",
    "db:seed-content": "tsx --env-file=.env prisma/seed-content.ts",
    "db:seed-glossary": "tsx --env-file=.env prisma/seed-glossary.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:launch": "tsx --env-file=.env scripts/check-launch.ts",
    "db:backup": "bash scripts/backup-db.sh"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.13",
    "next": "16.4.2",
    "next-intl": "^4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4",
    "ios_saf >= 16.4"
  ]
}
